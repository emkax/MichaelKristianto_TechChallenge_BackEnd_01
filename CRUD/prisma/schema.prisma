generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


enum CoffeeSize {
  SMALL
  MEDIUM
  LARGE
}

model Coffee {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(10,2)
  stock       Int       @default(0)
  size CoffeeSize
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
